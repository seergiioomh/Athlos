# Copia este archivo como `.env` y rellena los valores.
# `.env` está en .gitignore: no se sube al repositorio.
#
# Todo lo que lleva el prefijo EXPO_PUBLIC_ se incrusta en el bundle de la app
# y es legible por cualquiera que la descargue. Nunca pongas aquí una clave
# privada: la de Anthropic y la service_role viven como secretos de Supabase.

# Panel de Supabase → Project Settings → Data API
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
